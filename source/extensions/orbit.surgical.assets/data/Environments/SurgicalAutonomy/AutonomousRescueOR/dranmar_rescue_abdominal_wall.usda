#usda 1.0
(
    defaultPrim = "DrAnmarRescueAbdominalWall"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
    doc = "NVIDIA Omni Physics aligned bilateral volume-deformable abdominal wall rescue substrate."
)

def Xform "DrAnmarRescueAbdominalWall" (
    assetInfo = { string name = "DrAnmarRescueAbdominalWall" string version = "0.3.0" }
    kind = "component"
    prepend variantSets = "repair_state"
    variants = { string repair_state = "open" }
)
{
    custom string drAnmarStatus = "research_only"
    custom string drAnmarDeformableContract = "current_omni_physics_volume_deformable"
    custom bool drAnmarClinicalValidation = false
    def Scope "Looks"
    {
        def Material "WallVisual"
        {
            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "BaseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/rescue_abdominal_wall_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DrAnmarRescueAbdominalWall/Looks/WallVisual/PrimvarReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DrAnmarRescueAbdominalWall/Looks/WallVisual/BaseColorTexture.outputs:rgb>
                float inputs:roughness = 0.55
                float inputs:metallic = 0
                float inputs:opacity = 1
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarRescueAbdominalWall/Looks/WallVisual/PreviewSurface.outputs:surface>
        }
        def Material "WallPhysics" (
            prepend apiSchemas = ["OmniPhysicsBaseMaterialAPI", "OmniPhysicsDeformableMaterialAPI", "PhysxDeformableMaterialAPI"]
        )
        {
            float omniphysics:density = 1040
            float omniphysics:dynamicFriction = 0.58
            float omniphysics:staticFriction = 0.58
            float omniphysics:youngsModulus = 85000
            float omniphysics:poissonsRatio = 0.47
            float physxDeformableMaterial:elasticityDamping = 0.12
        }
    }
    def Xform "LeftWall" (
        prepend apiSchemas = ["OmniPhysicsDeformableBodyAPI", "PhysxBaseDeformableBodyAPI", "MaterialBindingAPI"]
    )
    {
        float omniphysics:mass = 0.9864192
        bool physxDeformableBody:disableGravity = true
        bool physxDeformableBody:selfCollision = false
        rel material:binding:physics = </DrAnmarRescueAbdominalWall/Looks/WallPhysics>

        def TetMesh "SimulationMesh" (
