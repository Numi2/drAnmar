#usda 1.0
(
    defaultPrim = "DrAnmarPhysiologicalMonitor"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarPhysiologicalMonitor" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "SemanticsLabelsAPI:class"]
    customData = { string drAnmarAssetId = "dranmar-physiological-monitor-v1" bool drAnmarClinicalValidation = false }
