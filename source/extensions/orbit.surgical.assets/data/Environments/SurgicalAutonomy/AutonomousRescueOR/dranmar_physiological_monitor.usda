    def Scope "PhysicsMaterials"
    {
        def Material "DefaultContact" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.48
            float physics:dynamicFriction = 0.36
            float physics:restitution = 0.01
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
        def Material "ToolCouplingContact" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.72
            float physics:dynamicFriction = 0.55
            float physics:restitution = 0.0
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }
    def Scope "Geometry"
    {
        def Cylinder "Pole" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </DrAnmarPhysiologicalMonitor/Looks/Metal>
            uniform token axis = "Z"
            double radius = 0.032
            double height = 1.25
            double3 xformOp:translate = (0, 0, 0.67)
            quatf xformOp:orient = (1, 0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
        def Cube "Base" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </DrAnmarPhysiologicalMonitor/Looks/DarkMetal>
            rel material:binding:physics = </DrAnmarPhysiologicalMonitor/PhysicsMaterials/DefaultContact>
            bool physics:collisionEnabled = true
            double size = 1
            double3 xformOp:translate = (0, 0, 0.04)
            double3 xformOp:scale = (0.42, 0.3, 0.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "Body" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </DrAnmarPhysiologicalMonitor/Looks/DarkMetal>
            double size = 1
            double3 xformOp:translate = (0, 0, 1.25)
            double3 xformOp:scale = (0.62, 0.1, 0.4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "Screen" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </DrAnmarPhysiologicalMonitor/Looks/Screen>
            double size = 1
            double3 xformOp:translate = (0, -0.056, 1.25)
            double3 xformOp:scale = (0.54, 0.012, 0.32)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
    def Scope "Frames"
    {
        def Xform "screen_center"
        {
            double3 xformOp:translate = (0, -0.063, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "alarm_light"
        {
            double3 xformOp:translate = (0, -0.063, 1.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "network_port"
        {
            double3 xformOp:translate = (0.25, 0.05, 1.14)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "count_reference"
        {
            double3 xformOp:translate = (0, 0, 0)
