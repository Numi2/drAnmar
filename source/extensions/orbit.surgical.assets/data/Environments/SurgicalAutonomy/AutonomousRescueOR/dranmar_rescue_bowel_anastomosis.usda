#usda 1.0
(
    defaultPrim = "DrAnmarRescueBowelAnastomosis"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
    doc = "Two hollow volume-deformable bowel ends for anastomotic rescue and leak revision."
)

def Xform "DrAnmarRescueBowelAnastomosis" (
    assetInfo = { string name = "DrAnmarRescueBowelAnastomosis" string version = "0.3.0" }
    kind = "component"
    prepend variantSets = "anastomosis_state"
    variants = { string anastomosis_state = "leaking" }
)
{
    custom string drAnmarStatus = "research_only"
    custom string drAnmarDeformableContract = "current_omni_physics_volume_deformable"
    custom bool drAnmarClinicalValidation = false
    def Scope "Looks"
    {
        def Material "BowelVisual"
        {
            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "BaseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/rescue_bowel_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DrAnmarRescueBowelAnastomosis/Looks/BowelVisual/PrimvarReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DrAnmarRescueBowelAnastomosis/Looks/BowelVisual/BaseColorTexture.outputs:rgb>
                float inputs:roughness = 0.55
                float inputs:metallic = 0
                float inputs:opacity = 1
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarRescueBowelAnastomosis/Looks/BowelVisual/PreviewSurface.outputs:surface>
        }
        def Material "BowelPhysics" (
            prepend apiSchemas = ["OmniPhysicsBaseMaterialAPI", "OmniPhysicsDeformableMaterialAPI", "PhysxDeformableMaterialAPI"]
        )
        {
            float omniphysics:density = 1045
            float omniphysics:dynamicFriction = 0.52
            float omniphysics:staticFriction = 0.52
            float omniphysics:youngsModulus = 52000
            float omniphysics:poissonsRatio = 0.48
            float physxDeformableMaterial:elasticityDamping = 0.16
        }
    }
    def Xform "ProximalBowel" (
        prepend apiSchemas = ["OmniPhysicsDeformableBodyAPI", "PhysxBaseDeformableBodyAPI", "MaterialBindingAPI"]
    )
    {
        float omniphysics:mass = 0.05696011899
        bool physxDeformableBody:disableGravity = true
        bool physxDeformableBody:selfCollision = true
        rel material:binding:physics = </DrAnmarRescueBowelAnastomosis/Looks/BowelPhysics>

        def TetMesh "SimulationMesh" (
            prepend apiSchemas = ["OmniPhysicsVolumeDeformableSimAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI", "OmniPhysicsDeformablePoseAPI:bind"]
        )
