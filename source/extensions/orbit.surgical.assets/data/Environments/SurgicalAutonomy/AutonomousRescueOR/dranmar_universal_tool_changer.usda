            bool physics:rigidBodyEnabled = true
            bool physics:kinematicEnabled = false
            float physics:mass = 0.21
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.00018, 0.00018, 0.00012)
            quatf physics:principalAxes = (1, 0, 0, 0)

            def Cylinder "Visual" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </DrAnmarUniversalToolChanger/Looks/DarkMetal>
                uniform token axis = "Z"
                double radius = 0.055
                double height = 0.05
                double3 xformOp:translate = (0, 0, 0.025)
                quatf xformOp:orient = (1, 0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
