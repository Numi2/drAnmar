    def Scope "PhysicsMaterials"
    {
        def Material "DefaultContact" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.48
            float physics:dynamicFriction = 0.36
            float physics:restitution = 0.01
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
        def Material "ToolCouplingContact" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.72
            float physics:dynamicFriction = 0.55
            float physics:restitution = 0.0
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }
    def Scope "Environment"
    {
        def Cube "Floor" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </DrAnmarAutonomousRescueOR/Looks/Floor>
            double size = 1
            double3 xformOp:translate = (0, 0, 0)
            double3 xformOp:scale = (4.2, 4.2, 0.04)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "TableBase" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </DrAnmarAutonomousRescueOR/Looks/Table>
            double size = 1
            double3 xformOp:translate = (0, 0, 0.72)
            double3 xformOp:scale = (0.72, 1.86, 0.12)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "Mattress" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </DrAnmarAutonomousRescueOR/Looks/Mattress>
            double size = 1
            double3 xformOp:translate = (0, 0, 0.82)
            double3 xformOp:scale = (0.66, 1.75, 0.08)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
    def Xform "Patient" (
        prepend references = @../../../Props/Patients/DynamicAbdominalPatient/dranmar_dynamic_abdominal_patient.usda@</DrAnmarDynamicAbdominalPatient>
        prepend variantSets = "access_state"
        variants = { string access_state = "open" }
    )
    {
        double3 xformOp:translate = (0, 0, 1.015)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "DeformableRescueSuite" (
        prepend references = @./dranmar_deformable_rescue_suite.usda@
    )
    {
        double3 xformOp:translate = (0, 0, 1.055)
        uniform token visibility = "invisible"
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "ToolCarousel" (
