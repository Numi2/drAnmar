#usda 1.0
(
    defaultPrim = "DrAnmarAutonomousRescueOR"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
    doc = "DrAnmar rescue operating-room layout; live robot articulations are supplied by the host scene."
)

def Xform "DrAnmarAutonomousRescueOR" (
    prepend apiSchemas = ["SemanticsLabelsAPI:class"]
    assetInfo = { string name = "DrAnmarAutonomousRescueOR" string version = "0.4.0" }
    customData = {
        string drAnmarAssetId = "dranmar-autonomous-rescue-or-v0.4.0"
        string drAnmarEffectAuthority = "environment_post_physics_scene_evidence"
        bool drAnmarClinicalValidation = false
        string drAnmarStatus = "research_only_not_for_patient_care"
        string drAnmarOptionalPatientIntegration = "Props/Patients/DynamicAbdominalPatient"
        string drAnmarAutonomyModes = "observer_advisory_supervised_autonomous_research"
        int drAnmarStationFrameCount = 4
        int drAnmarAssetLiveArticulationCount = 0
        int drAnmarToolSlotCount = 12
        string drAnmarDeformableGuidance = "OmniPhysics110_IsaacLab3_surface_volume_attachments"
    }
    prepend variantSets = ["scenario", "room_state"]
)
{
    token[] semantics:labels:class = ["surgical_operating_room_layout", "host_populated_robot_stations", "complication_rescue_system"]
    def Scope "Looks"
    {
        def Material "Floor"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.14, 0.17, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.62
                float inputs:opacity = 1
                token outputs:surface
