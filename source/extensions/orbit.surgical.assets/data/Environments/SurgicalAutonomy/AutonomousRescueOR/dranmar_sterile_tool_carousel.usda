    def Scope "Joints"
    {
    def PhysicsRevoluteJoint "carousel_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        rel physics:body0 = </DrAnmarSterileToolCarousel/Links/Base>
        rel physics:body1 = </DrAnmarSterileToolCarousel/Links/Rotor>
        uniform token physics:axis = "Z"
        point3f physics:localPos0 = (0, 0, 0.57)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -180
        float physics:upperLimit = 180
        bool physics:collisionEnabled = false
        uniform token drive:angular:physics:type = "force"
        float drive:angular:physics:targetPosition = -180
        float drive:angular:physics:targetVelocity = 0
        float drive:angular:physics:stiffness = 220
        float drive:angular:physics:damping = 18
        float drive:angular:physics:maxForce = 90
    }
    }
