#usda 1.0
(
    defaultPrim = "DrAnmarRescueVessel"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
    doc = "Hollow volume-deformable vessel rescue substrate with hemorrhage, compression, clip, and patch interfaces."
)

def Xform "DrAnmarRescueVessel" (
    assetInfo = { string name = "DrAnmarRescueVessel" string version = "0.3.0" }
    kind = "component"
    prepend variantSets = "hemostasis_state"
    variants = { string hemostasis_state = "bleeding" }
)
{
    custom string drAnmarStatus = "research_only"
    custom string drAnmarDeformableContract = "current_omni_physics_volume_deformable"
    custom bool drAnmarClinicalValidation = false
    def Scope "Looks"
    {
        def Material "VesselVisual"
        {
            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "BaseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/rescue_vessel_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DrAnmarRescueVessel/Looks/VesselVisual/PrimvarReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DrAnmarRescueVessel/Looks/VesselVisual/BaseColorTexture.outputs:rgb>
                float inputs:roughness = 0.42
                float inputs:metallic = 0
                float inputs:opacity = 1
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarRescueVessel/Looks/VesselVisual/PreviewSurface.outputs:surface>
        }
        def Material "VesselPhysics" (
            prepend apiSchemas = ["OmniPhysicsBaseMaterialAPI", "OmniPhysicsDeformableMaterialAPI", "PhysxDeformableMaterialAPI"]
        )
        {
            float omniphysics:density = 1060
            float omniphysics:dynamicFriction = 0.42
            float omniphysics:staticFriction = 0.42
            float omniphysics:youngsModulus = 420000
            float omniphysics:poissonsRatio = 0.48
            float physxDeformableMaterial:elasticityDamping = 0.18
        }
    }
    def Xform "VesselWall" (
        prepend apiSchemas = ["OmniPhysicsDeformableBodyAPI", "PhysxBaseDeformableBodyAPI", "MaterialBindingAPI"]
    )
    {
        float omniphysics:mass = 0.004041083219
        bool physxDeformableBody:disableGravity = true
        bool physxDeformableBody:selfCollision = true
        rel material:binding:physics = </DrAnmarRescueVessel/Looks/VesselPhysics>

        def TetMesh "SimulationMesh" (
            prepend apiSchemas = ["OmniPhysicsVolumeDeformableSimAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI", "OmniPhysicsDeformablePoseAPI:bind"]
        )
