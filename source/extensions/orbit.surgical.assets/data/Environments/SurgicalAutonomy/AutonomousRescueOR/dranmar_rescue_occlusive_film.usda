#usda 1.0
(
    defaultPrim = "DrAnmarRescueOcclusiveFilm"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
    doc = "Single-mesh triangular surface-deformable rescue dressing film with perimeter attachment masks."
)

def Xform "DrAnmarRescueOcclusiveFilm" (
    assetInfo = { string name = "DrAnmarRescueOcclusiveFilm" string version = "0.3.0" }
    kind = "component"
    prepend variantSets = "seal_state"
    variants = { string seal_state = "delaminated" }
)
{
    custom string drAnmarStatus = "research_only"
    custom string drAnmarDeformableContract = "current_omni_physics_surface_deformable"
    custom bool drAnmarClinicalValidation = false
    custom bool drAnmarKinematicVertexTargetsAllowed = false
    def Scope "Looks"
    {
        def Material "FilmVisual"
        {
            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "BaseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/rescue_film_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DrAnmarRescueOcclusiveFilm/Looks/FilmVisual/PrimvarReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DrAnmarRescueOcclusiveFilm/Looks/FilmVisual/BaseColorTexture.outputs:rgb>
                float inputs:roughness = 0.22
                float inputs:metallic = 0
                float inputs:opacity = 0.68
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarRescueOcclusiveFilm/Looks/FilmVisual/PreviewSurface.outputs:surface>
        }
        def Material "FilmPhysics" (
            prepend apiSchemas = ["OmniPhysicsBaseMaterialAPI", "OmniPhysicsDeformableMaterialAPI", "OmniPhysicsSurfaceDeformableMaterialAPI", "PhysxSurfaceDeformableMaterialAPI"]
        )
        {
            float omniphysics:density = 1020
            float omniphysics:dynamicFriction = 0.48
            float omniphysics:staticFriction = 0.48
            float omniphysics:youngsModulus = 28000000
            float omniphysics:poissonsRatio = 0.42
            float omniphysics:surfaceThickness = 0.0003
            float omniphysics:surfaceStretchStiffness = 0
            float omniphysics:surfaceShearStiffness = 0
            float omniphysics:surfaceBendStiffness = 2833090.497
            float physxDeformableMaterial:elasticityDamping = 0.03
            float physxDeformableMaterial:bendDamping = 0.04
        }
    }
