    def Scope "PhysicsMaterials"
    {
        def Material "DefaultContact" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.48
            float physics:dynamicFriction = 0.36
            float physics:restitution = 0.01
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
        def Material "ToolCouplingContact" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.72
            float physics:dynamicFriction = 0.55
            float physics:restitution = 0.0
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }
    def Scope "Links"
    {
        def Xform "Rack" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            bool physics:rigidBodyEnabled = true
            bool physics:kinematicEnabled = false
            float physics:mass = 24
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (1.2, 1.1, 0.45)
            quatf physics:principalAxes = (1, 0, 0, 0)

            def Cube "Base" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </DrAnmarResuscitationModule/Looks/DarkMetal>
                rel material:binding:physics = </DrAnmarResuscitationModule/PhysicsMaterials/DefaultContact>
                bool physics:collisionEnabled = true
                double size = 1
                double3 xformOp:translate = (0, 0, -0.62)
                double3 xformOp:scale = (0.46, 0.42, 0.12)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
            def Cube "Column" (
