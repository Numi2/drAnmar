#usda 1.0
(
    defaultPrim = "DrAnmarProtectedDuctBranch"
    doc = "DrAnmar protected duct branch with a removable continuity joint and explicit injury state."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarProtectedDuctBranch" (
    prepend variantSets = "integrity"
    variants = { string integrity = "intact" }
    customData = {
        string drAnmarAssetId = "dranmar-protected-duct-branch-v1"
        string drAnmarStructureKind = "duct"
        bool drAnmarClinicalValidation = false
