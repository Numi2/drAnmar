#usda 1.0
(
    defaultPrim = "DrAnmarProtectedNerveBranch"
    doc = "DrAnmar protected nerve branch with a removable continuity joint and explicit injury state."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarProtectedNerveBranch" (
    prepend variantSets = "integrity"
    variants = { string integrity = "intact" }
    customData = {
        string drAnmarAssetId = "dranmar-protected-nerve-branch-v1"
        string drAnmarStructureKind = "nerve"
        bool drAnmarClinicalValidation = false
