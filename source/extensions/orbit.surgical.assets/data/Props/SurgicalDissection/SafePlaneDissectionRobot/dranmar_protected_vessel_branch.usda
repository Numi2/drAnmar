#usda 1.0
(
    defaultPrim = "DrAnmarProtectedVesselBranch"
    doc = "DrAnmar protected vessel branch with a removable continuity joint and explicit injury state."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarProtectedVesselBranch" (
    prepend variantSets = "integrity"
    variants = { string integrity = "intact" }
    customData = {
        string drAnmarAssetId = "dranmar-protected-vessel-branch-v1"
        string drAnmarStructureKind = "vessel"
        bool drAnmarClinicalValidation = false
