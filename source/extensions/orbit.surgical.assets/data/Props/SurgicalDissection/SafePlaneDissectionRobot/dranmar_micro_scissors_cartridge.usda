#usda 1.0
(
    defaultPrim = "DrAnmarMicroScissorsCartridge"
    doc = "Replaceable guarded microsurgical scissors cartridge for DrAnmar SafePlane dissection."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

