#usda 1.0
(
    defaultPrim = "DrAnmarNeedleSuture4_0"
    doc = "Research-grade 4-0 braided suture factory-swaged to the pinned ORBIT atraumatic needle; not clinically validated."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarNeedleSuture4_0" (
    customData = {
        bool drAnmarClinicalValidation = false
        string drAnmarNeedleAssetSha256 = "2b317a61f93631a7192e7ed2839ef20f7a75c05aa5f84a3905696134a64f36d7"
        string drAnmarProfileId = "dr-anmar-suture-4-0-braided-v1"
        string drAnmarSwageConnection = "fixed_needle_to_interface_then_breakable_pullout_joint"
        string drAnmarStatus = "research_informed_engineering_model_pending_physical_and_clinical_validation"
    }
)
{
    def Xform "Needle" (
        prepend references = @../Surgical_needle/needle_sdf.usd@
    )
    {
        double3 xformOp:scale = (0.4, 0.4, 0.4)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Xform "Suture" (
        prepend references = @DrAnmarSuture4_0.usda@
    )
    {
        double3 xformOp:translate = (0.01939628732, 0.01967634588, 0.0003829604)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "NeedleInterface"
        {
            bool physics:kinematicEnabled = false
        }
    }

    def PhysicsFixedJoint "FactorySwage"
    {
        rel physics:body0 = </DrAnmarNeedleSuture4_0/Needle>
        rel physics:body1 = </DrAnmarNeedleSuture4_0/Suture/NeedleInterface>
        point3f physics:localPos0 = (0.0478657183, 0.0491908647, 0.000957401)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        bool physics:collisionEnabled = false
    }
}
