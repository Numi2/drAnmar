            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI", "PhysxCollisionAPI"]
        )
        {
            bool physics:collisionEnabled = true
            rel material:binding:physics = </DrAnmarCuretteCartridge/PhysicsMaterials/CurettePhysics>
            custom token drAnmar:role = "debridement_contact_surface"
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0.003)
            float physxCollision:contactOffset = 0.0005
            float physxCollision:restOffset = 0
            uniform token axis = "Z"
            double radius = 0.0094
            double height = 0.003
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }
    def Scope "Frames"
    {
        def Xform "cartridge_mount"
        {
            double3 xformOp:translate = (0, 0, -0.003)
            quatf xformOp:orient = (1, 0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            custom token drAnmar:role = "cartridge_mount"
            custom token drAnmar:parentLink = "DrAnmarCuretteCartridge"
        }
        def Xform "contact_reference"
        {
            double3 xformOp:translate = (0, 0, 0.005)
            quatf xformOp:orient = (1, 0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            custom token drAnmar:role = "debridement_contact"
            custom token drAnmar:parentLink = "DrAnmarCuretteCartridge"
        }
    }
}
