                token inputs:sourceColorSpace = "sRGB"
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float2 inputs:st.connect = </DrAnmarCuretteCartridge/Looks/MountMetal/Primvar.outputs:result>
                float3 outputs:rgb
