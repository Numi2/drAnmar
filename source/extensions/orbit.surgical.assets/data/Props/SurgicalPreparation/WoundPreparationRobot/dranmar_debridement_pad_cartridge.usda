        def Material "MountMetal"
        {
            token outputs:surface.connect = </DrAnmarPadCartridge/Looks/MountMetal/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DrAnmarPadCartridge/Looks/MountMetal/Texture.outputs:rgb>
                float inputs:metallic = 0.88
                float inputs:roughness = 0.2
                float inputs:opacity = 1
                token outputs:surface
            }
            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/brushed_metal_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float2 inputs:st.connect = </DrAnmarPadCartridge/Looks/MountMetal/Primvar.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Primvar"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
