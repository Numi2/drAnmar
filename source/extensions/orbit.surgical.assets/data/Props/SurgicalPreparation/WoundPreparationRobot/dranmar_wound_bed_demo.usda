            def Scope "Collisions"
            {
                def Cube "AdhesionPatch" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI", "PhysxCollisionAPI"]
                )
                {
                    double size = 1
                    bool physics:collisionEnabled = true
                    rel material:binding:physics = </DrAnmarWoundBedDemo/PhysicsMaterials/DebrisPhysics>
                    custom token drAnmar:role = "debris_attachment_region"
                    quatf xformOp:orient = (1, 0, 0, 0)
                    double3 xformOp:translate = (-9.37009282e-05, -0.03001510556, -0.005055591906)
                    float physxCollision:contactOffset = 0.0005
                    float physxCollision:restOffset = 0
                    double3 xformOp:scale = (0.007187756138, 0.006444245142, 0.001824862231)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }
