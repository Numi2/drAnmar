#usda 1.0
(
    defaultPrim = "DrAnmarWoundBedDemo"
    doc = "Dr.Anmar wound-bed simulation-training surface with detachable debris fragments."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarWoundBedDemo" (
    prepend apiSchemas = ["SemanticsLabelsAPI:class", "SemanticsLabelsAPI:workflow"]
    kind = "component"
)
{
    token[] semantics:labels:class = ["wound_bed", "debridement_training_surface"]
    token[] semantics:labels:workflow = ["inspection", "irrigation", "debridement", "aspiration"]
    def Scope "Looks"
    {
        def Material "MountMetal"
        {
            token outputs:surface.connect = </DrAnmarWoundBedDemo/Looks/MountMetal/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DrAnmarWoundBedDemo/Looks/MountMetal/Texture.outputs:rgb>
                float inputs:metallic = 0.88
                float inputs:roughness = 0.2
                float inputs:opacity = 1
                token outputs:surface
            }
            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/brushed_metal_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float2 inputs:st.connect = </DrAnmarWoundBedDemo/Looks/MountMetal/Primvar.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Primvar"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

        }
