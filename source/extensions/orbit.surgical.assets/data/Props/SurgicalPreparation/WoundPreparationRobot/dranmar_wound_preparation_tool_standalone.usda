#usda 1.0
(
    defaultPrim = "DrAnmarWoundPreparationTool"
    doc = "Dr.Anmar simulation-training end effector with irrigation, aspiration, rotary debridement, and inspection."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarWoundPreparationTool" (
    prepend apiSchemas = ["SemanticsLabelsAPI:class", "SemanticsLabelsAPI:workflow", "PhysicsArticulationRootAPI"]
    prepend variantSets = ["irrigation_state", "collection_state"]
    variants = {
        string irrigation_state = "loaded"
        string collection_state = "empty"
    }
    assetInfo = {
        string name = "DrAnmarWoundPreparationTool"
        string version = "0.1.0"
    }
    customData = {
        string drAnmarStatus = "simulation_training_workcell"
        string drAnmarMountInterface = "franka_panda_link8_hand_replacement"
        string drAnmarMechanism = "concentric_irrigation_annular_aspiration_rotary_debridement_and_multimodal_inspection"
        string drAnmarCoordinateConvention = "+Z approach, +X lateral, +Y wound tangent"
        bool drAnmarClinicalValidation = false
        bool drAnmarMedicalDevice = false
    }
    kind = "component"
)
{
    token[] semantics:labels:class = ["robotic_wound_preparation_end_effector", "surgical_preparation_device"]
    token[] semantics:labels:workflow = ["wound_inspection", "irrigation", "aspiration", "debridement"]

    def Scope "Looks"
    {
        def Material "MountMetal"
        {
            token outputs:surface.connect = </DrAnmarWoundPreparationTool/Looks/MountMetal/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DrAnmarWoundPreparationTool/Looks/MountMetal/Texture.outputs:rgb>
                float inputs:metallic = 0.88
                float inputs:roughness = 0.2
                float inputs:opacity = 1
                token outputs:surface
            }
            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/brushed_metal_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float2 inputs:st.connect = </DrAnmarWoundPreparationTool/Looks/MountMetal/Primvar.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Primvar"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

        }
