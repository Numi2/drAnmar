    def Scope "Collisions"
    {
        def Capsule "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI", "PhysxCollisionAPI"]
        )
        {
            bool physics:collisionEnabled = true
            rel material:binding:physics = </DrAnmarIrrigationDroplet/PhysicsMaterials/WaterPhysics>
            custom token drAnmar:role = "collision"
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            float physxCollision:contactOffset = 0.0005
            float physxCollision:restOffset = 0
            uniform token axis = "Z"
            double radius = 0.00065
            double height = 0
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }
    def Scope "Frames"
    {
        def Xform "center"
        {
            double3 xformOp:translate = (0, 0, 0)
            quatf xformOp:orient = (1, 0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            custom token drAnmar:role = "particle_center"
            custom token drAnmar:parentLink = "DrAnmarIrrigationDroplet"
        }
    }
