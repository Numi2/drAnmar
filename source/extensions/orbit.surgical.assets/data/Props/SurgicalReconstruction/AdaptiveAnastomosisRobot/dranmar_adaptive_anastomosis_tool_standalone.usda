#usda 1.0
(
    defaultPrim = "DrAnmarAdaptiveAnastomosisToolStandalone"
    doc = "DrAnmar Adaptive Anastomosis Robot: bilateral hollow-tissue capture, coaxial alignment, eversion, circumferential stapling, reinforcement, patency and leak verification research asset."
