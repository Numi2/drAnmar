    def Scope "Collisions"
    {
        def Cube "OpenEnvelope" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double size = 0.01
            float3 xformOp:scale = (0.9, 1, 0.18)
                        float physxCollision:contactOffset = 0.00045
            float physxCollision:restOffset = 0
            rel material:binding:physics = </DrAnmarAnastomosisStaple/PhysicsMaterials/StaplePhysics>
            custom string drAnmar:role = "open_staple_collision"
            quatf xformOp:orient = (1, 0, 0, 0)
