        def Scope "Collisions"
        {
            def Cylinder "GuardRingCollider" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                custom string drAnmar:role = "collision"
                rel material:binding:physics = </DrAnmarPerfusionViabilityToolStandalone/PhysicsMaterials/ProbeContactPhysics>
                bool physics:collisionEnabled = true
                float physxCollision:contactOffset = 0.00035
                float physxCollision:restOffset = 0
                double3 xformOp:translate = (0, 0, 0)
                quatf xformOp:orient = (1, 0, 0, 0)
                uniform token axis = "Z"
                double radius = 0.055
                double height = 0.008
                uniform token purpose = "guide"
                token visibility = "invisible"
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }
        def Scope "Frames"
        {
            def Xform "contact_guard_force"
            {
                custom string drAnmar:role = "contact_guard_force_reference"
                double3 xformOp:translate = (0, 0, 0)
                quatf xformOp:orient = (1, 0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }
    }
