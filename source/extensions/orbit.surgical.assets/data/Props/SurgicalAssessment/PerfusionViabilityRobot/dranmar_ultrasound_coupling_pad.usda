#usda 1.0
(
    defaultPrim = "DrAnmarUltrasoundCouplingPad"
    doc = "Ultrasound coupling pad and gel-contact proxy for robotic scanning tasks."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarUltrasoundCouplingPad" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        string drAnmarAssetId = "dranmar-ultrasound-coupling-pad-v1"
        bool drAnmarClinicalValidation = false
    }
)
{
    float physics:mass = 0.006
    def Scope "Looks"
    {
        def Material "CouplingGel"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.68, 0.92)
                float inputs:metallic = 0
                float inputs:roughness = 0.04
                float inputs:opacity = 0.44
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarUltrasoundCouplingPad/Looks/CouplingGel/PreviewSurface.outputs:surface>
        }
    }
    def Scope "PhysicsMaterials"
    {
        def Material "GelPhysics" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.22
            float physics:dynamicFriction = 0.18
            float physics:restitution = 0
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }
    def Mesh "Visual" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </DrAnmarUltrasoundCouplingPad/Looks/CouplingGel>
        custom token[] drAnmar:labels = ["ultrasound_coupling_pad"]
