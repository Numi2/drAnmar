def Xform "LaparotomySponge" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    assetInfo = {
        string identifier = "i4h.surgical_count.laparotomy_sponge.folded_proxy"
        string name = "Radiopaque Laparotomy Sponge - Folded Rigid Proxy"
        string version = "0.1.0"
    }
    customData = {
        string assetId = "i4h.surgical_count.laparotomy_sponge"
        string clinicalClass = "surgical_sponge"
        string clinicalSubtype = "laparotomy_sponge"
        string countCategory = "sponge"
        bool rigidProxy = true
        bool singleUse = true
        bool xrayDetectable = true
        string xrayMarkerRepresentation = "blue_edge_region_visual_abstraction"
        string loopRole = "counting_and_retrieval"
        string loopPhysicsMode = "compound_capsule_colliders"
        string simulationUse = "simulation_training_component"
        string[] semanticLabels = ["surgical_sponge", "laparotomy_sponge", "radiopaque_sponge"]
    }
    kind = "component"
    prepend variantSets = "state"
    variants = {
        string state = "dry"
    }
)
{
    bool physics:rigidBodyEnabled = true
    def Scope "Looks"
    {
        def Material "CottonDry"
        {
            token outputs:surface.connect = </LaparotomySponge/Looks/CottonDry/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </LaparotomySponge/Looks/CottonDry/BaseColor.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness.connect = </LaparotomySponge/Looks/CottonDry/Roughness.outputs:r>
                normal3f inputs:normal.connect = </LaparotomySponge/Looks/CottonDry/Normal.outputs:rgb>
                token outputs:surface
            }
            def Shader "BaseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cotton_dry_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </LaparotomySponge/Looks/CottonDry/PrimvarReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Roughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cotton_dry_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </LaparotomySponge/Looks/CottonDry/PrimvarReader.outputs:result>
                float outputs:r
            }
            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cotton_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </LaparotomySponge/Looks/CottonDry/PrimvarReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "CottonWet"
        {
            token outputs:surface.connect = </LaparotomySponge/Looks/CottonWet/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </LaparotomySponge/Looks/CottonWet/BaseColor.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness.connect = </LaparotomySponge/Looks/CottonWet/Roughness.outputs:r>
                normal3f inputs:normal.connect = </LaparotomySponge/Looks/CottonWet/Normal.outputs:rgb>
                token outputs:surface
            }
            def Shader "BaseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cotton_wet_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </LaparotomySponge/Looks/CottonWet/PrimvarReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Roughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cotton_wet_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </LaparotomySponge/Looks/CottonWet/PrimvarReader.outputs:result>
                float outputs:r
            }
            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cotton_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </LaparotomySponge/Looks/CottonWet/PrimvarReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "MedicalBlue"
        {
            token outputs:surface.connect = </LaparotomySponge/Looks/MedicalBlue/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.16, 0.72)
                float inputs:metallic = 0
                float inputs:roughness = 0.46
                token outputs:surface
            }
        }

        def Material "DryPhysics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.75
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0
        }

        def Material "WetPhysics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.65
            float physics:dynamicFriction = 0.55
            float physics:restitution = 0
        }
    }

