        prepend apiSchemas = ["SemanticsLabelsAPI:class"]
    )
    {
        token[] semantics:labels:class = ["liver_parenchyma"]
        def Mesh "Visual" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
