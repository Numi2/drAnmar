#usda 1.0
(
    defaultPrim = "DrAnmarOncologyLiverDemo"
    doc = "DrAnmar deformable-ready liver tumor resection substrate with physical vascular and duct structures."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarOncologyLiverDemo" (
    prepend apiSchemas = ["SemanticsLabelsAPI:class"]
    customData = {
        string drAnmarStatus = "simulation_training_scenario"
        string drAnmarTumorField = "./tumor_field.json"
        string drAnmarResectionTopology = "./resection_topology.json"
        float drAnmarPlannedMarginM = 0.01
    }
    prepend variantSets = ["procedure_state", "pathology_state"]
    variants = {
        string procedure_state = "initial"
        string pathology_state = "multifocal"
    }
)
{
    token[] semantics:labels:class = ["liver", "tumor_resection_substrate", "surgical_oncology_patient_asset"]
    def Scope "Looks"
    {
        def Material "WhitePolymer"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.82, 0.84)
                float inputs:metallic = 0
                float inputs:roughness = 0.28
                float inputs:opacity = 1
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarOncologyLiverDemo/Looks/WhitePolymer/PreviewSurface.outputs:surface>
        }
        def Material "DarkPolymer"
        {
