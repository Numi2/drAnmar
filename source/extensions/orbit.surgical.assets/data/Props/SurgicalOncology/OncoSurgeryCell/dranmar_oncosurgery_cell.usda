#usda 1.0
(
    defaultPrim = "DrAnmarOncoSurgeryCell"
    doc = "Three-station oncology research cell: mapping, resection and specimen-assistance work zones around a shared patient."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarOncoSurgeryCell" (
    prepend apiSchemas = ["SemanticsLabelsAPI:class"]
    customData = { string drAnmarStatus = "simulation_training_workcell" }
)
{
    token[] semantics:labels:class = ["multi_robot_surgical_cell", "surgical_oncology_workcell"]
    def Xform "PatientStation" {
        def Xform "PatientReference" ( references = @./dranmar_oncology_liver_demo.usda@ ) {}
    }
    def Xform "MapperStation"
    {
        custom string intendedTool = "multimodal_perfusion_and_tumor_mapping"
    }
    def Xform "ResectorStation"
    {
        custom string intendedTool = "adaptive_tumor_resection"
    }
    def Xform "AssistantStation"
    {
        custom string intendedTool = "exposure_hemostasis_and_specimen_handling"
    }
    def Scope "Coordination" {
        custom token[] workZones = ["mapping", "resection", "specimen_handoff", "cavity_verification"]
        custom bool collisionAwareScheduling = true
        custom bool sharedPatientState = true
        custom string coordinationContract = "oncologic_resection_task_contract.json"
    }
}
