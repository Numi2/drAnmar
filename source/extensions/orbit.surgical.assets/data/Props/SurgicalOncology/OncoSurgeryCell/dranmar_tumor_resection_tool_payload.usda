            float drive:linear:physics:maxForce = 25
        }
        def PhysicsPrismaticJoint "irrigation_valve_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            rel physics:body0 = </DrAnmarTumorResectionTool/Links/Mount>
            rel physics:body1 = </DrAnmarTumorResectionTool/Links/IrrigationValve>
            point3f physics:localPos0 = (0.04, 0.042, 0.03)
            point3f physics:localPos1 = (0, 0, -0.014)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            uniform token physics:axis = "Z"
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.008
            bool physics:collisionEnabled = false
            uniform token drive:linear:physics:type = "force"
            float drive:linear:physics:targetPosition = 0
            float drive:linear:physics:targetVelocity = 0
            float drive:linear:physics:stiffness = 300
            float drive:linear:physics:damping = 20
            float drive:linear:physics:maxForce = 25
        }
    }
