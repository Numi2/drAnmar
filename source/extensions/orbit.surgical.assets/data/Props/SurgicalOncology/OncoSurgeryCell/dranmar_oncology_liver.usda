#usda 1.0
(
    defaultPrim = "DrAnmarOncologyLiverDemo"
    doc = "Lightweight interface layer for the registered DrAnmar liver oncology substrate."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarOncologyLiverDemo" (
    kind = "component"
    assetInfo = {
        string identifier = "dranmar-oncology-liver-v0.2.0"
        string name = "DrAnmar Oncology Liver"
        string version = "0.2.0"
    }
    payload = @./dranmar_oncology_liver_demo.usda@
    prepend variantSets = ["procedure_state", "pathology_state"]
    variants = {
        string procedure_state = "initial"
        string pathology_state = "multifocal"
    }
)
{
    variantSet "procedure_state" = {
        "initial" {}
        "mapped" {}
        "planned" {}
        "resected" {}
        "corrected" {}
    }
    variantSet "pathology_state" = {
        "solitary" {}
        "multifocal" {}
    }
}
