#usda 1.0
(
    defaultPrim = "SkinStapler"
    doc = "Six-DOF velocity-damped fixture composition of the Dr.Anmar articulated skin stapler."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SkinStapler" (
    prepend references = @../SkinStapler/skin_stapler_articulated.usda@
)
{
    custom string drAnmar:testCellMount = "six_dof_velocity_fixture"
    custom bool drAnmar:clinicalValidation = false
    double3 xformOp:translate = (0, 0, 0.0592)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    over "Links"
    {
        over "Housing"
        {
            float physics:mass = 5
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.05, 0.05, 0.05)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }
    }

}
