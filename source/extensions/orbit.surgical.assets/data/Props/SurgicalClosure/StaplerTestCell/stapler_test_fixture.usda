#usda 1.0
(
    defaultPrim = "StaplerTestFixture"
    doc = "Dr.Anmar fixed stapler cradle, actuator guide and synthetic closure coupon. Research-only simulation fixture."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "StaplerTestFixture" (
    assetInfo = {
        string name = "DrAnmarStaplerTestFixture"
        string version = "0.1.0"
    }
    kind = "component"
)
{
    custom bool drAnmar:clinicalValidation = false
    custom string drAnmar:simulationUse = "mechanism_test_fixture_not_tissue_or_clinical_validation"
    custom string drAnmar:fixtureType = "fixed_housing_virtual_linear_trigger_actuator"

    def Scope "Looks"
    {
        def Material "Base"
        {
            token outputs:surface.connect = </StaplerTestFixture/Looks/Base/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.075, 0.085)
                float inputs:metallic = 0.65
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }
        def Material "Cradle"
        {
            token outputs:surface.connect = </StaplerTestFixture/Looks/Cradle/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.10, 0.34, 0.39)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }
        def Material "Actuator"
        {
            token outputs:surface.connect = </StaplerTestFixture/Looks/Actuator/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.46, 0.12)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.30
                token outputs:surface
            }
        }
        def Material "Coupon"
        {
            token outputs:surface.connect = </StaplerTestFixture/Looks/Coupon/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.38, 0.39)
                float inputs:metallic = 0
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Target"
        {
            token outputs:surface.connect = </StaplerTestFixture/Looks/Target/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.82, 0.76)
                color3f inputs:emissiveColor = (0.02, 0.18, 0.17)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
    }

    def Cube "Base" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:scale = (0.30, 0.16, 0.008)
        double3 xformOp:translate = (0.0, 0.0, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </StaplerTestFixture/Looks/Base>
        bool physics:collisionEnabled = false
    }

    def Xform "HousingCradle"
    {
        custom string drAnmar:role = "fixed_stapler_housing_support"

        def Cube "LeftRail" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:scale = (0.115, 0.010, 0.027)
            double3 xformOp:translate = (-0.020, 0.021, 0.0175)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </StaplerTestFixture/Looks/Cradle>
            bool physics:collisionEnabled = false
        }
        def Cube "RightRail" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:scale = (0.115, 0.010, 0.027)
            double3 xformOp:translate = (-0.020, -0.021, 0.0175)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </StaplerTestFixture/Looks/Cradle>
            bool physics:collisionEnabled = false
        }
        def Cube "RearStop" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:scale = (0.010, 0.052, 0.050)
            double3 xformOp:translate = (-0.094, 0.0, 0.029)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </StaplerTestFixture/Looks/Cradle>
            bool physics:collisionEnabled = false
        }
    }

    def Xform "ActuatorGuide"
    {
        custom string drAnmar:role = "virtual_trigger_actuator_visual_reference"
        custom float drAnmar:triggerLimitDeg = 28
        custom float drAnmar:fireThresholdDeg = 24

        def Cube "Column" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:scale = (0.016, 0.056, 0.072)
            double3 xformOp:translate = (-0.122, 0.0, 0.040)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </StaplerTestFixture/Looks/Actuator>
            bool physics:collisionEnabled = false
        }
        def Cube "Plunger" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom string drAnmar:role = "trigger_contact_reference"
            double size = 1
            double xformOp:rotateY = -66.8
            double3 xformOp:scale = (0.052, 0.014, 0.014)
            double3 xformOp:translate = (-0.087, 0.0, 0.018)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
            rel material:binding = </StaplerTestFixture/Looks/Actuator>
        }
    }

    def Xform "ClosureBed"
    {
        custom string drAnmar:role = "dr_anmar_suturable_tissue_support"
        custom string drAnmar:validationBoundary = "static_tissue_placement_proxy_not_penetration_deformation_or_closure_strength"

        def Cube "Pedestal" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:scale = (0.080, 0.090, 0.046)
            double3 xformOp:translate = (0.095, 0.0, 0.027)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </StaplerTestFixture/Looks/Base>
            bool physics:collisionEnabled = false
        }
        def Cube "ClosureLine" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:scale = (0.045, 0.0006, 0.0004)
            double3 xformOp:translate = (0.095, 0.0, 0.0504)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </StaplerTestFixture/Looks/Target>
        }
    }

    def Xform "Frames"
    {
        def Xform "fixture_origin"
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "stapler_root"
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0592)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "tissue_target"
        {
            double3 xformOp:translate = (0.096, 0.0, 0.0602)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
