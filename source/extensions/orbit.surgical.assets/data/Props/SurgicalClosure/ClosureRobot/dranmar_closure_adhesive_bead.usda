#usda 1.0
(
    defaultPrim = "DrAnmarClosureAdhesiveBead"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarClosureAdhesiveBead" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "SemanticsLabelsAPI:class"]
    prepend variantSets = "state"
    variants = { string state = "fresh" }
    kind = "component"
)
{
    token[] semantics:labels:class = ["topical_skin_adhesive", "adhesive_bead"]
    bool physics:rigidBodyEnabled = true
    bool physxRigidBody:enableCCD = true
    custom float drAnmar:cureFraction = 0
