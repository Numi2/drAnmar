#usda 1.0
(
    defaultPrim = "DrAnmarClosureTool"
    doc = "Dr.Anmar simulation-training wound-closure end effector for tissue approximation, staple deployment, and topical adhesive application."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarClosureTool" (
    prepend apiSchemas = ["SemanticsLabelsAPI:class", "SemanticsLabelsAPI:workflow"]
    prepend variantSets = ["staple_state", "adhesive_state"]
    variants = {
        string staple_state = "loaded"
        string adhesive_state = "full"
    }
    assetInfo = {
        string name = "DrAnmarClosureTool"
        string version = "0.1.0"
    }
    customData = {
        string drAnmarStatus = "simulation_training_instrument"
        string drAnmarMountInterface = "franka_panda_link8_hand_replacement"
        string drAnmarMechanism = "bilateral_capture_then_approximate_then_staple_then_adhesive"
        string drAnmarCoordinateConvention = "+Z approach, +X across wound, +Y along wound"
        bool drAnmarClinicalValidation = false
        bool drAnmarMedicalDevice = false
    }
    kind = "component"
)
{
    token[] semantics:labels:class = ["robotic_closure_end_effector", "surgical_closure_device"]
    token[] semantics:labels:workflow = ["tissue_approximation", "stapling", "adhesive_closure"]

    def Scope "Looks"
    {
        def Material "MountMetal"
        {
            token outputs:surface.connect = </DrAnmarClosureTool/Looks/MountMetal/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DrAnmarClosureTool/Looks/MountMetal/Texture.outputs:rgb>
                float inputs:metallic = 0.86
                float inputs:roughness = 0.2
                float inputs:opacity = 1
                token outputs:surface
            }
            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/brushed_metal_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float2 inputs:st.connect = </DrAnmarClosureTool/Looks/MountMetal/Primvar.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Primvar"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

        }
