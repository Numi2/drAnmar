#usda 1.0
(
    defaultPrim = "SkinStaple"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)

def Xform "SkinStaple" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    custom string dranmar:assetId = "dranmar.surgical_closure.skin_stapler.formed_staple"
    custom string dranmar:version = "0.2.0"
    custom string dranmar:license = "Apache-2.0"
    custom token dranmar:productCapability = "simulation_training_component"
    custom string[] dranmar:semanticLabels = ["skin_staple", "closure", "disposal"]
    custom string dranmar:representation = "formed_deployed_rigid_staple"
    custom string dranmar:parameterStatus = "category_reference_geometry_not_manufacturer_metrology"
    bool physics:rigidBodyEnabled = 1
    bool physics:kinematicEnabled = 0
    float physics:mass = 0.000030924676
