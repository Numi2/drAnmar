#usda 1.0
(
    defaultPrim = "SkinStaplerRigidProxy"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)

def Xform "SkinStaplerRigidProxy" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    variants = {
        string state = "loaded"
    }
    prepend variantSets = "state"
)
{
    custom string dranmar:assetId = "dranmar.surgical_closure.skin_stapler.rigid_proxy"
    custom string dranmar:assetName = "DrAnmar Skin Stapler rigid proxy"
    custom string dranmar:version = "0.2.0"
    custom string dranmar:license = "Apache-2.0"
    custom token dranmar:productCapability = "simulation_training_instrument"
    custom string dranmar:representation = "single_rigid_body_open_trigger_loaded_or_empty"
    custom string[] dranmar:semanticLabels = ["skin_stapler", "surgical_closure_device", "handover", "closure", "disposal"]
    custom token[] dranmar:supportedStates = ["loaded", "empty"]
    bool physics:rigidBodyEnabled = 1
    bool physics:kinematicEnabled = 0
    variantSet "state" = {
        "loaded" {
            custom token dranmar:activeState = "loaded"
            custom string[] dranmar:activeSemanticLabels = ["skin_stapler", "surgical_closure_device", "loaded", "handover", "closure", "disposal"]
            float physics:mass = 0.063211878739
            point3f physics:centerOfMass = (-0.014386598182, -0.000000109179, 0.016533684484)
            float3 physics:diagonalInertia = (0.00003141413658, 0.0001785979711, 0.00020378369276)
            quatf physics:principalAxes = (0.70320397076, 0.703201053438, -0.074203258698, 0.074204651804)
            custom int dranmar:stapleCount = 35
            custom bool dranmar:canDeployStaple = 1
            over "Visuals"
            {
                over "StateIndicator"
                {
                    rel material:binding = </SkinStaplerRigidProxy/Looks/LoadedIndicator>
                    color3f[] primvars:displayColor = [(0.08, 0.67, 0.25)]
                    uniform token primvars:displayColor:interpolation = "constant"
                    float[] primvars:displayOpacity = [1]
                    uniform token primvars:displayOpacity:interpolation = "constant"
                    custom string[] dranmar:semanticLabels = ["skin_stapler", "loaded"]
                }
                over "StapleFollower"
                {
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }
                over "StapleStack"
                {
                    token visibility = "inherited"
                    custom string[] dranmar:semanticLabels = ["skin_staple", "loaded", "closure"]
                }
                over "ChamberedStaple"
                {
                    token visibility = "inherited"
                    custom string[] dranmar:semanticLabels = ["skin_staple", "loaded", "closure"]
                }
            }
            over "Colliders"
            {
                over "ChamberedStapleCrownCollider"
                {
                    bool physics:collisionEnabled = 1
                }
                over "ChamberedStapleLeftLegCollider"
                {
                    bool physics:collisionEnabled = 1
                }
                over "ChamberedStapleRightLegCollider"
                {
                    bool physics:collisionEnabled = 1
                }
            }
        }
        "empty" {
            custom token dranmar:activeState = "empty"
            custom string[] dranmar:activeSemanticLabels = ["skin_stapler", "surgical_closure_device", "empty", "handover", "closure", "disposal"]
            float physics:mass = 0.062
            point3f physics:centerOfMass = (-0.014880162848, -0.000000111313, 0.016338907222)
            float3 physics:diagonalInertia = (0.00003133043883, 0.00017734313858, 0.00020248093427)
            quatf physics:principalAxes = (0.703212949207, 0.703210041259, -0.074118080374, 0.074119471816)
            custom int dranmar:stapleCount = 0
            custom bool dranmar:canDeployStaple = 0
            over "Visuals"
            {
                over "StateIndicator"
                {
                    rel material:binding = </SkinStaplerRigidProxy/Looks/EmptyIndicator>
                    color3f[] primvars:displayColor = [(0.77, 0.07, 0.045)]
                    uniform token primvars:displayColor:interpolation = "constant"
                    float[] primvars:displayOpacity = [1]
                    uniform token primvars:displayOpacity:interpolation = "constant"
                    custom string[] dranmar:semanticLabels = ["skin_stapler", "empty"]
                }
                over "StapleFollower"
                {
                    double3 xformOp:translate = (0.057, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }
                over "StapleStack"
                {
                    token visibility = "invisible"
                    custom string[] dranmar:semanticLabels = ["skin_staple", "empty", "closure"]
                }
                over "ChamberedStaple"
                {
                    token visibility = "invisible"
                    custom string[] dranmar:semanticLabels = ["skin_staple", "empty", "closure"]
                }
            }
            over "Colliders"
            {
                over "ChamberedStapleCrownCollider"
                {
                    bool physics:collisionEnabled = 0
                }
                over "ChamberedStapleLeftLegCollider"
                {
                    bool physics:collisionEnabled = 0
                }
                over "ChamberedStapleRightLegCollider"
                {
                    bool physics:collisionEnabled = 0
                }
            }
        }
    }
    def Scope "Looks"
    {
        def Material "BodyPolymer"
        {
            token outputs:surface.connect = </SkinStaplerRigidProxy/Looks/BodyPolymer/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </SkinStaplerRigidProxy/Looks/BodyPolymer/BaseColor.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness.connect = </SkinStaplerRigidProxy/Looks/BodyPolymer/Roughness.outputs:r>
                normal3f inputs:normal.connect = </SkinStaplerRigidProxy/Looks/BodyPolymer/Normal.outputs:rgb>
                token outputs:surface
            }
            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "BaseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/body_polymer_basecolor.png@
                float2 inputs:st.connect = </SkinStaplerRigidProxy/Looks/BodyPolymer/PrimvarReader.outputs:result>
                token inputs:sourceColorSpace = "sRGB"
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
