                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token axis = "X"
                double height = 0.002
                double radius = 0.00775
                double3 xformOp:translate = (-0.0095, 0, 0)
                quatf xformOp:orient = (1, 0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                float3[] extent = [(-0.001, -0.00775, -0.00775), (0.001, 0.00775, 0.00775)]
                bool physics:collisionEnabled = 1
                float physxCollision:contactOffset = 0.0003
                float physxCollision:restOffset = 0
                rel material:binding:physics = </DrAnmarSkinAdhesiveCap/PhysicsMaterials/CapPhysics>
                uniform token purpose = "guide"
                token visibility = "invisible"
                custom string[] dranmar:semanticLabels = ["snap_fit"]
            }
    }

    def Scope "Frames"
    {
        def Xform "cap_grasp"
        {
            custom string dranmar:frameRole = "robot_cap_grasp"
            custom string dranmar:parentLink = "Cap"
            double3 xformOp:translate = (0.002, 0, 0)
            quatf xformOp:orient = (1, 0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "cap_snap_axis"
        {
            custom string dranmar:frameRole = "applicator_tip_alignment"
            custom string dranmar:parentLink = "Cap"
