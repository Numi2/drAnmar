                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
                    )
                    {
                        uniform token axis = "X"
                        double height = 0.0035
                        double radius = 0.0041
                        double3 xformOp:translate = (0.037, 0, 0)
                        quatf xformOp:orient = (1, 0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                        float3[] extent = [(-0.00175, -0.0041, -0.0041), (0.00175, 0.0041, 0.0041)]
                        bool physics:collisionEnabled = 1
                        float physxCollision:contactOffset = 0.0003
                        float physxCollision:restOffset = 0
                        rel material:binding:physics = </DrAnmarSkinAdhesiveApplicator/PhysicsMaterials/PistonPhysics>
                        uniform token purpose = "guide"
                        token visibility = "invisible"
                        custom string[] dranmar:semanticLabels = ["metering_piston"]
                    }
            }
        }
    }

    def Scope "Joints"
    {
        def PhysicsRevoluteJoint "left_paddle_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </DrAnmarSkinAdhesiveApplicator/Links/Body>
            rel physics:body1 = </DrAnmarSkinAdhesiveApplicator/Links/LeftPaddle>
            point3f physics:localPos0 = (-0.033, 0.00955, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -11
            float physics:upperLimit = 0
            bool physics:collisionEnabled = 0
            uniform token drive:angular:physics:type = "force"
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            float drive:angular:physics:stiffness = 0.075
            float drive:angular:physics:damping = 0.012
            float drive:angular:physics:maxForce = 1.8
            custom string dranmar:parameterStatus = "provisional_return_spring"
