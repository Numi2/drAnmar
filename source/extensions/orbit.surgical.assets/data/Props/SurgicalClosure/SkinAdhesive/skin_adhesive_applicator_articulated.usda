#usda 1.0
(
    defaultPrim = "DrAnmarSkinAdhesiveApplicator"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarSkinAdhesiveApplicator" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "SemanticsLabelsAPI:class", "SemanticsLabelsAPI:workflow"]
    variants = {
        string state = "sealed"
    }
    prepend variantSets = "state"
)
{
    token[] semantics:labels:class = ["skin_adhesive_applicator", "surgical_closure_device"]
    token[] semantics:labels:workflow = ["handover", "uncapping", "activation", "dispensing", "closure", "disposal"]
    custom string dranmar:assetId = "dranmar.surgical_closure.skin_adhesive_applicator"
    custom string dranmar:assetName = "DrAnmar Topical Skin Adhesive Applicator"
    custom string dranmar:version = "0.1.0"
    custom string dranmar:catalogSubpath = "Props/SurgicalClosure/SkinAdhesive"
    custom string dranmar:license = "Apache-2.0"
    custom token dranmar:productCapability = "simulation_training_instrument"
    custom string dranmar:geometryClass = "original_category_level_robot_oriented_dual_paddle_skin_adhesive_applicator"
    custom token[] dranmar:supportedStates = ["sealed", "activated", "empty"]
    custom string[] dranmar:semanticLabels = ["skin_adhesive_applicator", "topical_skin_adhesive", "surgical_closure_device", "handover", "closure", "disposal"]
    custom token dranmar:forwardAxis = "positive_x"
    custom token dranmar:upAxis = "positive_z"
    custom float dranmar:paddleTravelDeg = 11
    custom float dranmar:pistonTravelM = 0.009
    custom string dranmar:couplingModel = "runtime_average_paddle_closure_maps_to_metering_piston_translation"
    custom string dranmar:depositModel = "separate_kinematic_bead_task_asset_not_a_fluid_solver"
    custom string dranmar:parameterStatus = "enabled_provisional_unmeasured_values_disclosed_in_physics_profile"
    custom asset dranmar:capAsset = @skin_adhesive_cap.usda@
    custom asset dranmar:beadAsset = @skin_adhesive_bead.usda@
    bool physics:articulationEnabled = 1

    variantSet "state" = {
        "sealed" {
            custom token dranmar:activeState = "sealed"
            custom string[] dranmar:activeSemanticLabels = ["skin_adhesive_applicator", "surgical_closure_device", "sealed", "handover", "closure", "disposal"]
            custom float dranmar:remainingAdhesiveMl = 0.5
            custom bool dranmar:isActivated = 0
            custom bool dranmar:canDispense = 0
            over "Links"
            {
                over "Body"
                {
                    float physics:mass = 0.0188
                    point3f physics:centerOfMass = (-0.0333276086083, -6.10968159413e-05, 9.15628407125e-06)
                    float3 physics:diagonalInertia = (8.40903372942e-07, 3.69717317239e-06, 3.82006778216e-06)
                    quatf physics:principalAxes = (0.999988974877, -0.00463538319092, -0.000138268269535, 0.000737719134232)
                    custom token dranmar:discreteState = "sealed"
                    over "Visuals"
                    {
                        over "ReservoirLiquid"
                        {
                            rel material:binding = </DrAnmarSkinAdhesiveApplicator/Looks/SealedAdhesiveVisual>
                            token visibility = "inherited"
                        }
                        over "ApplicatorWick"
                        {
                            rel material:binding = </DrAnmarSkinAdhesiveApplicator/Looks/WickDry>
                            token visibility = "inherited"
                        }
                        over "StateIndicator"
                        {
                            rel material:binding = </DrAnmarSkinAdhesiveApplicator/Looks/IndicatorSealed>
                            token visibility = "inherited"
                        }
                    }
                    over "Colliders"
                    {
                        over "TipCollider"
                        {
                            rel material:binding:physics = </DrAnmarSkinAdhesiveApplicator/PhysicsMaterials/TipDryPhysics>
                        }
                    }
                }
            }
        }
        "activated" {
            custom token dranmar:activeState = "activated"
            custom string[] dranmar:activeSemanticLabels = ["skin_adhesive_applicator", "surgical_closure_device", "activated", "handover", "closure", "disposal", "dispensing"]
            custom float dranmar:remainingAdhesiveMl = 0.46
            custom bool dranmar:isActivated = 1
            custom bool dranmar:canDispense = 1
            over "Links"
            {
                over "Body"
                {
                    float physics:mass = 0.0186
                    point3f physics:centerOfMass = (-0.0331710131295, -6.10968159413e-05, 9.15628407125e-06)
                    float3 physics:diagonalInertia = (8.31957391382e-07, 3.7961898589e-06, 3.9177768303e-06)
                    quatf physics:principalAxes = (0.999988980288, -0.00463521084766, -0.000127882319288, 0.000733327484643)
                    custom token dranmar:discreteState = "activated"
                    over "Visuals"
                    {
                        over "ReservoirLiquid"
                        {
                            rel material:binding = </DrAnmarSkinAdhesiveApplicator/Looks/ActivatedAdhesiveVisual>
                            token visibility = "inherited"
                        }
                        over "ApplicatorWick"
                        {
                            rel material:binding = </DrAnmarSkinAdhesiveApplicator/Looks/WickActivated>
                            token visibility = "inherited"
                        }
                        over "StateIndicator"
                        {
                            rel material:binding = </DrAnmarSkinAdhesiveApplicator/Looks/IndicatorActivated>
                            token visibility = "inherited"
                        }
                    }
                    over "Colliders"
                    {
                        over "TipCollider"
                        {
                            rel material:binding:physics = </DrAnmarSkinAdhesiveApplicator/PhysicsMaterials/TipActivatedPhysics>
                        }
                    }
                }
            }
        }
        "empty" {
            custom token dranmar:activeState = "empty"
            custom string[] dranmar:activeSemanticLabels = ["skin_adhesive_applicator", "surgical_closure_device", "empty", "handover", "closure", "disposal"]
            custom float dranmar:remainingAdhesiveMl = 0
            custom bool dranmar:isActivated = 1
            custom bool dranmar:canDispense = 0
            over "Links"
            {
                over "Body"
                {
                    float physics:mass = 0.0157
                    point3f physics:centerOfMass = (-0.034557262192, -6.44616151008e-05, 9.66055023426e-06)
                    float3 physics:diagonalInertia = (7.3559747199e-07, 2.69815278073e-06, 2.80582489251e-06)
                    quatf physics:principalAxes = (0.999988922274, -0.0046596235572, -0.000219007974447, 0.000628707107932)
                    custom token dranmar:discreteState = "empty"
                    over "Visuals"
                    {
                        over "ReservoirLiquid"
                        {
                            rel material:binding = </DrAnmarSkinAdhesiveApplicator/Looks/ActivatedAdhesiveVisual>
                            token visibility = "invisible"
                        }
                        over "ApplicatorWick"
                        {
                            rel material:binding = </DrAnmarSkinAdhesiveApplicator/Looks/WickSpent>
                            token visibility = "inherited"
                        }
                        over "StateIndicator"
                        {
                            rel material:binding = </DrAnmarSkinAdhesiveApplicator/Looks/IndicatorEmpty>
                            token visibility = "inherited"
                        }
                    }
                    over "Colliders"
                    {
                        over "TipCollider"
                        {
                            rel material:binding:physics = </DrAnmarSkinAdhesiveApplicator/PhysicsMaterials/TipSpentPhysics>
                        }
                    }
                }
            }
        }
    }

    def Scope "Looks"
    {
        def Material "BodyPolymer"
        {
            token outputs:surface.connect = </DrAnmarSkinAdhesiveApplicator/Looks/BodyPolymer/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DrAnmarSkinAdhesiveApplicator/Looks/BodyPolymer/BaseColor.outputs:rgb>
                float inputs:roughness.connect = </DrAnmarSkinAdhesiveApplicator/Looks/BodyPolymer/Roughness.outputs:r>
                normal3f inputs:normal.connect = </DrAnmarSkinAdhesiveApplicator/Looks/BodyPolymer/Normal.outputs:rgb>
                float inputs:metallic = 0
                float inputs:opacity = 1
                token outputs:surface
            }
                def Shader "PrimvarReader"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "BaseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @textures/body_polymer_basecolor.png@
                    float2 inputs:st.connect = </DrAnmarSkinAdhesiveApplicator/Looks/BodyPolymer/PrimvarReader.outputs:result>
                    token inputs:sourceColorSpace = "sRGB"
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }

                def Shader "Roughness"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @textures/polymer_roughness.png@
                    float2 inputs:st.connect = </DrAnmarSkinAdhesiveApplicator/Looks/BodyPolymer/PrimvarReader.outputs:result>
                    token inputs:sourceColorSpace = "raw"
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "Normal"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @textures/polymer_normal.png@
                    float2 inputs:st.connect = </DrAnmarSkinAdhesiveApplicator/Looks/BodyPolymer/PrimvarReader.outputs:result>
                    token inputs:sourceColorSpace = "raw"
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }
        }

        def Material "GripElastomer"
        {
            token outputs:surface.connect = </DrAnmarSkinAdhesiveApplicator/Looks/GripElastomer/PreviewSurface.outputs:surface>
