#usda 1.0
(
    defaultPrim = "DrAnmarSkinAdhesiveBead"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarSkinAdhesiveBead" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "SemanticsLabelsAPI:class", "SemanticsLabelsAPI:workflow"]
    variants = {
        string state = "fresh"
    }
    prepend variantSets = "state"
)
{
    token[] semantics:labels:class = ["skin_adhesive", "closure_material"]
    token[] semantics:labels:workflow = ["dispensing", "closure", "inspection"]
    custom string dranmar:assetId = "dranmar.surgical_closure.skin_adhesive_bead"
    custom string dranmar:assetName = "DrAnmar Topical Skin Adhesive Bead"
    custom string dranmar:version = "0.1.0"
    custom token dranmar:productCapability = "simulation_training_effect"
    custom string dranmar:representation = "kinematic_deposit_task_asset_not_a_fluid_or_curing_solver"
    custom token[] dranmar:supportedStates = ["fresh", "cured"]
    custom float dranmar:nominalLengthM = 0.07
    custom float dranmar:nominalWidthM = 0.0023
    custom float dranmar:nominalHeightM = 0.00076
    bool physics:rigidBodyEnabled = 1
    bool physics:kinematicEnabled = 1
    bool physxRigidBody:enableCCD = 1
    bool physxRigidBody:enableSpeculativeCCD = 1

    variantSet "state" = {
        "fresh" {
            custom token dranmar:activeState = "fresh"
            custom string[] dranmar:activeSemanticLabels = ["skin_adhesive", "topical_skin_adhesive", "fresh", "closure"]
            float physics:mass = 0.00024
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (1.47465946002e-09, 9.76956388527e-08, 9.91526324056e-08)
            quatf physics:principalAxes = (-0.0220508686547, -0.0220508686547, 0.706762873382, 0.706762873382)
            over "Visual"
            {
                rel material:binding = </DrAnmarSkinAdhesiveBead/Looks/FreshAdhesive>
            }
            over "Colliders"
