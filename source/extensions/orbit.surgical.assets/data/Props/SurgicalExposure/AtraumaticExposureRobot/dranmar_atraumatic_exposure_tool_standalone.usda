    variantSet "pad_type" = {
        "fenestrated" {
            over "Links"
            {
                    over "LeftPad"
                    {
                        over "Visuals"
                        {
                            over "FenestratedContact"
                            {
                                token visibility = "inherited"
                            }
                            over "MicrocupContact"
                            {
                                token visibility = "invisible"
                            }
                        }
                    }
                    over "RightPad"
                    {
                        over "Visuals"
                        {
                            over "FenestratedContact"
                            {
                                token visibility = "inherited"
                            }
                            over "MicrocupContact"
                            {
                                token visibility = "invisible"
                            }
                        }
                    }
            }
            custom token drAnmar:activePadType = "fenestrated"
        }
        "microcup" {
            over "Links"
            {
                    over "LeftPad"
                    {
                        over "Visuals"
                        {
                            over "FenestratedContact"
                            {
                                token visibility = "invisible"
                            }
                            over "MicrocupContact"
                            {
                                token visibility = "inherited"
