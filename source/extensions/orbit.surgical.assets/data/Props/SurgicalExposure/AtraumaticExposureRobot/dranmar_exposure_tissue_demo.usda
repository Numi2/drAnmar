                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = <../Texture.outputs:rgb>
                float inputs:metallic = 0.88
                float inputs:roughness = 0.22
                float inputs:opacity = 1
                token outputs:surface
