#usda 1.0
(
    defaultPrim = "DrAnmarDynamicAbdominalPatient"
    doc = "Modular DrAnmar dynamic abdominal research patient with anatomy, mechanics, physiology, and intervention contracts."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarDynamicAbdominalPatient" (
    assetInfo = {
        string name = "DrAnmarDynamicAbdominalPatient"
        string version = "0.1.0"
    }
    kind = "assembly"
    prepend variantSets = "access_state"
    variants = { string access_state = "intact" }
)
{
    custom string drAnmar:assetId = "dranmar-dynamic-abdominal-patient-v1"
    custom string drAnmar:coordinateSystem = "x_left_right_y_caudal_cranial_z_posterior_anterior"
    custom string drAnmar:runtimeContract = "patient.respiration patient.perfusion patient.bleeding patient.vital_signs patient.tissue_state patient.organ_motion patient.damage patient.interventions patient.robot patient.event_bus patient.fluids"
