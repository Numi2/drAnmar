    variantSet "access_state" = {
        "intact"
        {
            over "AccessMechanics"
            {
                over "LaparotomyWound"
                {
                    token visibility = "invisible"
                }
            }
            over "Anatomy"
            {
                over "skin" (
                    variants = { string access_state = "intact" }
                )
                {
                }
                over "subcutaneous_fat" (
                    variants = { string access_state = "intact" }
                )
                {
                }
                over "fascia" (
