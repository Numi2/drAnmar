# Python executable from an Isaac Sim / Isaac Lab-enabled environment.
ISAAC_PYTHON=/absolute/path/to/isaac-enabled/python

# Runtime data is kept outside the Git repository.
DR_ANMAR_ROOT="${HOME}/.local/share/dr-anmar"
DR_ANMAR_PORTABLE_ROOT="${DR_ANMAR_ROOT}/isaac_portable"

# Doctor Studio hub and one active Isaac worker.
DR_ANMAR_HUB_PORT=2360
DR_ANMAR_WORKER_PORT=2361
DR_ANMAR_HUB_HOST=127.0.0.1
DR_ANMAR_WORKER_HOST=127.0.0.1

# Recording safety bounds; raise deliberately for longer studies after measuring RAM and save latency.
DR_ANMAR_MAX_DEMO_SECONDS=300
DR_ANMAR_MAX_DEMO_FRAMES=60000
DR_ANMAR_MAX_DEMO_BYTES=1500000000
# Sensor budget: efficient (left RGB), stereo (left RGB-D + right RGB), or research (plus wrist cameras).
DR_ANMAR_SENSOR_PROFILE=research

# Optional shared-workstation access control. It is mandatory for a non-loopback bind.
DR_ANMAR_ACCESS_TOKEN=
# Set to 1 only when Doctor Studio is served over HTTPS.
DR_ANMAR_COOKIE_SECURE=0
# Non-loopback binding fails closed unless all three acknowledgements and an
# access token are set. TLS may terminate at a trusted reverse proxy.
DR_ANMAR_ALLOW_REMOTE=0
DR_ANMAR_TLS_TERMINATED=0
DR_ANMAR_FIREWALL_CONFIRMED=0

# External eye tracking/XR stays disabled unless an approved study explicitly enables all three values.
DR_ANMAR_ENABLE_EXTERNAL_OPERATOR_SENSORS=0
DR_ANMAR_STUDY_ID=
DR_ANMAR_CONSENT_PROTOCOL=

# Set to 1 only when installed OpenUSD anatomy assets must be rebuilt.
DR_ANMAR_REBUILD_OPENUSD=0
# Isolated multi-solver physics. The stable workstation remains the default.
DR_ANMAR_PHYSICS_BACKEND=stable
DR_ANMAR_ENABLE_EXPERIMENTAL_PHYSICS=0
# DR_ANMAR_PHYSICS_NEXT_ROOT=$HOME/.local/share/dr-anmar/physics-next

# Pinned NVIDIA Isaac for Healthcare providers and content-addressed asset cache.
DR_ANMAR_I4H_ROOT="${DR_ANMAR_ROOT}/vendor/i4h-workflows-current"
DR_ANMAR_I4H_ASSET_CATALOG_ROOT="${DR_ANMAR_ROOT}/vendor/i4h-asset-catalog-current"
I4H_ASSET_DOWNLOAD_DIR="${DR_ANMAR_ROOT}/assets/i4h-catalog"
