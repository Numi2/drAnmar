#usda 1.0
(
    defaultPrim = "DrAnmarSuturableTissueTet"
    doc = "DrAnmar Suturable Tissue: explicit backend-neutral tetrahedral simulation mesh; not clinically validated."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarSuturableTissueTet" (
    prepend apiSchemas = ["OmniPhysicsDeformableBodyAPI", "PhysxBaseDeformableBodyAPI", "MaterialBindingAPI"]
    customData = {
        string drAnmarAssetId = "dr-anmar-suturable-tissue"
        string drAnmarAssetName = "DrAnmar Suturable Tissue"
        string drAnmarAssetVersion = "1.0.0"
        string drAnmarAuthorship = "Independent Dr.Anmar procedural geometry, topology, mechanics and calibration contract"
        bool drAnmarClinicalValidation = false
        int drAnmarConnectedComponents = 1
        string drAnmarProfileId = "dr-anmar-suturable-tissue-v1"
        string drAnmarRepresentation = "explicit_openusd_tetmesh_with_surface_visualization"
        int drAnmarSimToRealGapCount = 10
        int drAnmarSurfaceTriangleCount = 1344
        int drAnmarTetrahedronCount = 5184
        int drAnmarVertexCount = 1235
        string drAnmarWoundTopology = "two_disconnected_watertight_flaps_with_open_incision"
        string drAnmarStatus = "research_informed_engineering_model_pending_bench_and_clinical_validation"
    }
)
{
    def Scope "Materials"
    {
        def Material "Surface"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.58, 0.18, 0.16)
                float inputs:metallic = 0
                float inputs:roughness = 0.58
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarSuturableTissueTet/Materials/Surface/PreviewSurface.outputs:surface>
        }

        def Material "Bulk"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.31, 0.26)
                float inputs:metallic = 0
                float inputs:roughness = 0.58
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarSuturableTissueTet/Materials/Bulk/PreviewSurface.outputs:surface>
        }

        def Material "Fascia"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.66, 0.45)
                float inputs:metallic = 0
                float inputs:roughness = 0.58
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarSuturableTissueTet/Materials/Fascia/PreviewSurface.outputs:surface>
        }

        def Material "Wound"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.035, 0.025)
                float inputs:metallic = 0
                float inputs:roughness = 0.58
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarSuturableTissueTet/Materials/Wound/PreviewSurface.outputs:surface>
        }
    }

    def Material "FEMPhysics" (
        prepend apiSchemas = ["OmniPhysicsBaseMaterialAPI", "OmniPhysicsDeformableMaterialAPI", "PhysxDeformableMaterialAPI"]
    )
    {
        float omniphysics:density = 1050
        float omniphysics:dynamicFriction = 0.3
        float omniphysics:staticFriction = 0.42
        float omniphysics:youngsModulus = 80000
        float omniphysics:poissonsRatio = 0.47
        float physxDeformableMaterial:elasticityDamping = 0.08
    }

    float omniphysics:mass = 0.0092289491928
