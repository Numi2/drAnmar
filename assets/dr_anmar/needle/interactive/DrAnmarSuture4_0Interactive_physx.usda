        bool physxRigidBody:enableCCD = true
        bool physxRigidBody:enableSpeculativeCCD = true
        float physxRigidBody:linearDamping = 0.015
        float physxRigidBody:angularDamping = 0.025
        int physxRigidBody:solverPositionIterationCount = 16
        int physxRigidBody:solverVelocityIterationCount = 4
        float physxRigidBody:maxDepenetrationVelocity = 0.25
        over "Collision" (
            prepend apiSchemas = ["PhysxCollisionAPI"]
        )
        {
            float physxCollision:contactOffset = 1.7e-05
            float physxCollision:restOffset = 0
        }
    }

