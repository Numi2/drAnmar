#usda 1.0
(
    defaultPrim = "DrAnmarNeedle"
    doc = "DrAnmar Needle visual look-development and binding layer. Composed by DrAnmarNeedle.usda."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "DrAnmarNeedle"
{
    def Scope "Looks"
    {
        def Material "NeedleSteelVisual"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.53, 0.58, 0.64)
                float inputs:metallic = 0.88
                float inputs:roughness = 0.22
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarNeedle/Looks/NeedleSteelVisual/PreviewSurface.outputs:surface>
        }
    }

    over "Needle"
    {
        over "Visual" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </DrAnmarNeedle/Looks/NeedleSteelVisual>
        }
    }
}
