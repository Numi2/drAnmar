#usda 1.0
(
    defaultPrim = "DrAnmarNeedle"
    doc = "Interactive Dr.Anmar needle composition. The native 90-segment PhysX strand preserves the authored dimensions and renders the same physical segment transforms."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarNeedle" (
    prepend references = @./interactive/DrAnmarNeedleInteractive.usda@
)
{
    over "Needle"
    {
        over "Collision" (
            active = false
        )
        {
        }

        over "Visual" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI", "PhysxSDFMeshCollisionAPI", "MaterialBindingAPI"]
        )
        {
            bool physics:collisionEnabled = true
            uniform token physics:approximation = "sdf"
            uniform token physxSDFMeshCollision:sdfBitsPerSubgridPixel = "BitsPerPixel16"
            bool physxSDFMeshCollision:sdfEnableRemeshing = false
            float physxSDFMeshCollision:sdfMargin = 0.01
            float physxSDFMeshCollision:sdfNarrowBandThickness = 0.01
            int physxSDFMeshCollision:sdfResolution = 256
            int physxSDFMeshCollision:sdfSubgridResolution = 6
            float physxSDFMeshCollision:sdfTriangleCountReductionFactor = 1
            rel material:binding:physics = </DrAnmarNeedle/Looks/NeedleSteelPhysics>
        }
    }
}
