#usda 1.0
(
    defaultPrim = "DrAnmarVessel"
    doc = "DrAnmar Vessel: hollow three-layer deformable vascular research asset; not clinically validated."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarVessel" (
    customData = {
        string drAnmarAssetId = "dr-anmar-vessel"
        string drAnmarAssetName = "DrAnmar Vessel"
        string drAnmarAssetVersion = "1.0.0"
        string drAnmarAuthorship = "Independent Dr.Anmar hollow vessel geometry, topology and mechanics contract"
        bool drAnmarClinicalValidation = false
        int drAnmarConnectedComponents = 1
        bool drAnmarHasOpenLumen = true
        string drAnmarProfileId = "dr-anmar-hemostasis-v1"
        string drAnmarRepresentation = "watertight_hollow_surface_for_native_physx_tetrahedral_cooking"
        int drAnmarSimToRealGapCount = 10
        int drAnmarSurfaceTriangleCount = 7488
        int drAnmarTetrahedronCount = 31104
        int drAnmarVertexCount = 7104
        string drAnmarWallTopology = "single_watertight_three_layer_hollow_tube"
        string drAnmarStatus = "research_informed_engineering_asset_pending_solver_bench_and_clinical_validation"
    }
)
{
    def Scope "Materials"
    {
        def Material "Outer"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.055, 0.045)
                float inputs:metallic = 0
                float inputs:roughness = 0.44
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarVessel/Materials/Outer/PreviewSurface.outputs:surface>
        }

        def Material "Inner"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.28, 0.22)
                float inputs:metallic = 0
                float inputs:roughness = 0.308
                token outputs:surface
            }
            token outputs:surface.connect = </DrAnmarVessel/Materials/Inner/PreviewSurface.outputs:surface>
        }

        def Material "Inlet"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.68, 0.16, 0.12)
                float inputs:metallic = 0
                float inputs:roughness = 0.44
                token outputs:surface
            }
