#usda 1.0
(
    subLayers = [
        @DrAnmarSuture4_0_physics.usda@
    ]
    defaultPrim = "DrAnmarSuture4_0"
    doc = "Dr.Anmar 4-0 suture PhysX-specific CCD, damping, solver, contact-offset, and combine-mode layer."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "DrAnmarSuture4_0"
{
    over "Materials"
    {
        over "SutureMaterial" (
            prepend apiSchemas = ["PhysxMaterialAPI"]
        )
        {
            uniform token physxMaterial:frictionCombineMode = "max"
        }

        over "SwageSteel" (
            prepend apiSchemas = ["PhysxMaterialAPI"]
