#usda 1.0
(
    defaultPrim = "DrAnmarSuture4_0"
    doc = "Dr.Anmar 4-0 suture interface with public NVIDIA-style Physics payload variants; not clinically validated."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarSuture4_0" (
    prepend references = @./DrAnmarSuture4_0_base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    variantSet "Physics" = {
        "none" {
        }
        "physics" (
            prepend payload = @./DrAnmarSuture4_0_physics.usda@
        ) {
        }
        "physx" (
            prepend payload = @./DrAnmarSuture4_0_physx.usda@
        ) {
        }
    }
}
