    {"id": "follow_curvature", "duration_s": 2.0},
    {"id": "exit", "duration_s": 0.6},
    {"id": "withdraw", "duration_s": 1.0},
    {"id": "recover", "duration_s": 2.0}
  ],
  "required_metrics": [
    "entry_event_count",
    "exit_event_count",
    "puncture_force_n",
    "withdrawal_force_n",
    "shaft_drag_n_mean",
    "tract_curvature_error_m",
    "entry_hole_residual_m",
    "exit_hole_residual_m",
