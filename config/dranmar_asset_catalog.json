{
  "schema": "dr.anmar.asset-catalog-policy.v1",
  "catalog_version": "1.3.0",
  "description": "One catalog contract for Dr.Anmar-owned OpenUSD and multimodal simulation assets plus the pinned NVIDIA Isaac for Healthcare provider.",
  "release": {
    "lock_path": "config/dranmar_asset_catalog.lock.json",
    "catalog_document_path": "catalog.md",
    "clinical_validation": false,
    "lock_required": true,
    "generated_catalog_required": true
  },
  "providers": {
    "dr_anmar": {
      "kind": "local",
      "root": "source/extensions/orbit.surgical.assets/data",
      "inventory_roots": [
        "."
      ],
      "license_fallback": "LICENSE",
      "ownership": "Dr.Anmar and retained upstream ORBIT-Surgical asset notices",
      "clinical_validation": false,
      "license_policy": "nearest asset license or repository fallback"
    },
    "dr_anmar_repository": {
      "kind": "local",
      "root": ".",
      "inventory_roots": [
        "assets/dr_anmar"
      ],
      "license_fallback": "LICENSE",
      "ownership": "Dr.Anmar repository-local assets",
      "clinical_validation": false,
      "license_policy": "nearest asset license or repository fallback"
    },
    "nvidia_i4h": {
      "kind": "external",
      "repository": "https://github.com/isaac-for-healthcare/i4h-asset-catalog.git",
      "release": "v0.7.0",
      "catalog_commit": "b0b7ad39f26490d58d12407cfa74b3c9ad861769",
      "asset_version": "0.7.0",
      "content_hash": "724f82e",
      "content_root_environment": "DR_ANMAR_I4H_ASSET_CONTENT_ROOT",
      "default_cache_subpath": "assets/i4h-catalog",
      "license_review_required": true,
      "clinical_validation": false
    }
  },
  "i4h_bundles": {
    "surgical-core": [
      "Robots/dVRK",
      "Robots/STAR",
      "Props/SutureNeedle",
      "Props/SuturePad",
      "Props/Table",
      "Props/SurgicalInstruments"
    ],
    "surgical-anatomy": [
      "Props/Organs"
    ],
    "ultrasound": [
      "Props/ABDPhantom",
      "Props/ClariusUltrasoundProbe",
      "Props/UltrasoundCameraFixture",
      "Props/VentionTable",
      "Robots/Franka"
    ],
    "medical-robots": [
      "Robots/KUKA_LBR",
      "Robots/Kinova"
    ],
    "rheo": [
      "Props/Lightwheel"
    ]
  },
  "quality": {
    "metadata_required_prefixes": {
      "dr_anmar": [
        "Environments/SurgicalAutonomy",
        "Props/Patients",
        "Props/SurgicalAssessment",
        "Props/SurgicalClosure",
        "Props/SurgicalCount",
        "Props/SurgicalDissection",
        "Props/SurgicalDivision",
        "Props/SurgicalExposure",
        "Props/SurgicalHemostasis",
        "Props/SurgicalOncology",
        "Props/SurgicalPreparation",
        "Props/SurgicalReconstruction"
      ],
      "dr_anmar_repository": [
        "assets/dr_anmar"
      ]
    },
    "metadata_contract_names": [
      "asset_manifest.json",
      "asset_bundle.json",
      "anatomy_manifest.json",
      "physics_profile.json",
      "mechanics_contract.json",
      "native_simulator_evidence.json",
      "tissue_closure_native_simulator_evidence.json"
    ],
    "non_usd_entrypoint_names": [
      "asset_bundle.json"
    ],
    "ignored_names": [
      ".DS_Store",
      "__pycache__"
    ],
    "growth_budgets": {
      "maximum_asset_unit_bytes": 67108864,
      "maximum_catalog_bytes": 536870912,
      "policy": "Large binary growth requires an explicit reviewed budget change; runtime data remains external."
    },
    "allowed_external_usd_schemes": []
  }
}
