{
  "schema_version": "1.0.0",
  "name": "Dr.Anmar Robotic Surgery RL Direction",
  "status": "adopted_research_direction",
  "scope": [
    "simulation",
    "robot_learning",
    "policy_evaluation",
    "research_deployment"
  ],
  "technical_thesis": {
    "target": "bounded_procedural_autonomy",
    "end_to_end_autonomous_surgeon": false,
    "reward_is_not_evidence": true,
    "patient_effects_are_physics_owned": true,
    "primary_evidence": [
      "task_success",
      "patient_benefit",
      "patient_harm",
      "constraint_violations",
      "failure_distribution",
      "recovery",
      "abstention",
      "runtime_efficiency"
    ]
  },
  "program_goal": {
    "objective": "minimize_time_to_qualified_task_achievement",
    "abbreviation": "TQTA",
    "start_event": "versioned_task_contract_is_frozen",
    "stop_event": "first_frozen_checkpoint_passes_held_out_competence_safety_and_recovery",
    "primary_unit": "wall_clock_seconds",
    "decomposition": [
      "gpu_hours_to_gate",
      "simulated_steps_to_gate",
      "successful_expert_demonstration_minutes_to_gate",
      "experiment_count_to_gate",
      "human_intervention_minutes_to_gate"
    ],
    "not_task_achievement": [
      "training_reward_threshold_alone",
      "single_seed_success",
      "successful_video_alone",
      "simulator_fps_alone"
    ]
  },
  "nvidia_stack": {
    "scene_authority": "OpenUSD",
    "stable_simulation": [
      "NVIDIA Isaac Sim",
      "NVIDIA PhysX"
    ],
    "learning_environment": "NVIDIA Isaac Lab manager-based environments",
    "state_policy_trainer": "RSL-RL PPO",
    "imitation_data": [
      "Isaac Lab Mimic",
      "Robomimic"
    ],
    "deformable_frontier": [
      "Newton",
      "NVIDIA Warp",
      "Dr.Anmar measured solver integrations"
    ],
    "deployment_after_hil": [
      "ONNX",
      "TensorRT",
      "NVIDIA Holoscan",
      "NVIDIA IGX"
    ],
    "generative_world_models": {
      "allowed": [
        "synthetic_visual_variation",
        "non_authoritative_policy_evaluation",
        "counterfactual_generation"
      ],
      "forbidden_authority": [
        "geometry",
        "contact",
        "force",
        "tissue_state",
        "patient_effects",
        "task_success",
        "safety"
      ]
    }
  },
  "policy_architecture": [
    {
      "order": 1,
      "id": "synchronized_sensing",
      "authority": "measured_or_simulator_owned",
      "outputs": [
        "stereo_rgbd",
        "semantics",
        "kinematics",
        "force_contact",
        "physiology"
      ]
    },
    {
      "order": 2,
      "id": "state_estimation",
      "authority": "learned_with_uncertainty",
      "requirements": [
        "timestamp_alignment",
        "frame_registration",
        "uncertainty",
        "observability_status"
      ]
    },
    {
      "order": 3,
      "id": "procedure_intent",
      "authority": "bounded_advisory",
      "allowed_policy_families": [
        "skill_graph",
        "goal_conditioned_transformer",
        "VLM",
        "VLA"
      ],
      "output": "qualified_skill_id_and_goal"
    },
    {
      "order": 4,
      "id": "local_skill_policy",
      "authority": "learned_bounded_action",
      "allowed_policy_families": [
        "recurrent_behavior_cloning",
        "ACT",
        "diffusion_policy",
        "residual_RL",
        "constrained_RL"
      ],
      "forbidden_policy_families": [
        "unshielded_VLM",
        "unshielded_VLA"
      ],
      "output": "relative_task_space_target_or_short_action_chunk"
    },
    {
      "order": 5,
      "id": "safety_shield",
      "authority": "hard_constraint",
      "requirements": [
        "workspace_limits",
        "no_go_zones",
        "force_limits",
        "speed_limits",
        "action_rejection",
        "neutral_stop"
      ]
    },
    {
      "order": 6,
      "id": "deterministic_controller",
      "authority": "final_actuator_target",
      "allowed": [
        "inverse_kinematics",
        "impedance_control",
        "visual_servoing",
        "rate_limiting"
      ]
    },
    {
      "order": 7,
      "id": "outcome_and_runtime_monitor",
      "authority": "continue_abstain_recover_or_takeover",
      "requirements": [
        "patient_benefit",
        "patient_harm",
        "failure_prediction",
        "out_of_distribution_detection",
        "abstention",
        "operator_takeover"
      ]
    }
  ],
  "algorithm_portfolio": [
    {
      "id": "rsl_rl_ppo",
      "role": "motor_foundation_and_privileged_teacher",
      "status": "primary"
    },
    {
      "id": "recurrent_behavior_cloning",
      "role": "demonstration_baseline",
      "status": "required_baseline"
    },
    {
      "id": "act",
      "role": "precise_multistep_visuomotor_policy",
      "status": "primary_candidate"
    },
    {
      "id": "diffusion_policy",
      "role": "multimodal_and_bimanual_visuomotor_policy",
      "status": "primary_candidate"
    },
    {
      "id": "diffusion_stabilizer_policy",
      "role": "perturbed_and_imperfect_demonstrations",
      "status": "reproduce_before_adoption"
    },
    {
      "id": "residual_rl",
      "role": "robustness_recovery_and_contact_refinement",
      "status": "preferred_contact_rich_rl"
    },
    {
      "id": "offline_rl",
      "role": "learn_from_retained_demonstration_and_intervention_data",
      "status": "research_after_dataset_gate"
    },
    {
      "id": "goal_conditioned_decision_transformer",
      "role": "high_level_skill_sequencing",
      "status": "planner_candidate"
    },
    {
      "id": "vla",
      "role": "assistive_tool_handling_and_skill_proposal",
      "status": "not_low_level_control"
    },
    {
      "id": "control_barrier_function",
      "role": "action_shield",
      "status": "required_research_direction"
    },
    {
      "id": "classical_servoing_and_planning",
      "role": "comparator_and_fallback",
      "status": "required"
    }
  ],
  "learning_tracks": [
