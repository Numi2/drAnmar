{
  "schema_version": "1.12.0",
  "name": "DrAnmar Learning Path",
  "runtime": {
    "simulator": "Isaac Sim 6",
    "environment": "Isaac Lab main",
    "trainer": "RSL-RL 5",
    "device": "NVIDIA CUDA GPU",
    "precision": "TF32-enabled PPO",
    "memory_fit": {
      "minimum_free_gpu_mib": 1024,
      "minimum_available_system_mib": 4096,
      "parallel_world_limit": "minimum of requested, live RAM cap, and live VRAM cap unless an exact count has already been qualified and DR_ANMAR_TRUST_REQUESTED_NUM_ENVS=1"
    }
  },
  "defaults": {
    "task": "DrAnmar-Reach-PSM-IK-Rel-v0",
    "num_envs": 1200,
    "environment_sweep": [1200],
    "training_seeds": [17, 43, 89],
    "held_out_seeds": [2361, 4099, 7919],
    "success_threshold": 0.95,
    "success_window": 10,
    "reach_observation_contract": [
      "joint_position",
      "joint_velocity",
      "commanded_pose",
      "target_relative_position",
      "target_relative_axis_angle_orientation",
      "previous_action"
    ],
    "success_source": "isaac_lab_termination_manager",
    "stage_1_initialization": {
      "method": "analytic_relative_ik_base_plus_learned_residual",
      "default_updates": 32,
      "ppo_role": "learn_bounded_residual_only_if_held_out_gate_fails"
    },
    "dual_reach_observation_contract": [
      "arm_1_joint_position",
      "arm_1_joint_velocity",
      "arm_2_joint_position",
      "arm_2_joint_velocity",
      "arm_1_commanded_pose",
      "arm_2_commanded_pose",
      "arm_1_target_relative_position",
      "arm_1_target_relative_axis_angle_orientation",
      "arm_2_target_relative_position",
      "arm_2_target_relative_axis_angle_orientation",
      "previous_dual_action"
    ],
    "stage_2_initialization": {
      "method": "dual_analytic_relative_ik_base_plus_learned_coordination_residual",
      "default_updates": 32,
      "dual_loop_gain": 0.25,
      "contact_mode": "disabled_free_space_control_qualification",
      "ppo_role": "learn_bounded_coordination_residual_only_if_held_out_gate_fails"
    },
    "stage_3_initialization": {
      "method": "analytic_grasp_lift_base_plus_learned_residual",
      "default_updates": 32,
      "approach_height_m": 0.02,
      "grasp_height_m": 0.008,
      "lateral_alignment_threshold_m": 0.004,
      "close_distance_to_grasp_m": 0.003,
      "slow_approach_radius_m": 0.02,
      "slow_approach_action_limit": 0.1,
      "normalized_contact_threshold": 0.002,
      "carry_action_limit": 0.1,
      "ppo_role": "learn_bounded_contact_residual_only_if_held_out_gate_fails"
    }
  },
  "stages": [
    {
      "stage": 1,
      "name": "single_tool_pose_control",
      "task": "DrAnmar-Reach-PSM-IK-Rel-v0",
      "promotion": {
        "minimum_success_rate": 0.95,
        "held_out_seed_passes": 3
      }
    },
    {
      "stage": 2,
      "name": "coordinated_dual_tool_pose_control",
      "task": "DrAnmar-Reach-Dual-PSM-IK-Rel-v0",
      "promotion": {
        "minimum_success_rate": 0.9,
        "held_out_seed_passes": 3
      }
    },
    {
      "stage": 3,
      "name": "contact_qualified_block_lift",
      "task": "DrAnmar-Lift-Block-PSM-IK-Rel-v0",
      "qualification_contract": {
        "control_hz": 50,
        "initial_object_height_m": 0.015,
        "initial_object_quaternion_xyzw": [0.0, 0.0, 0.0, 1.0],
        "target_object_height_m": 0.08,
        "minimum_success_height_m": 0.06,
        "sustained_success_steps": 10,
        "bilateral_contact_threshold_n": 0.01,
        "object_force_soft_limit_n": 1.0,
        "object_force_hard_limit_n": 5.0,
        "protected_surface_force_hard_limit_n": 2.0,
        "requires_orientation_alignment": true,
        "requires_stable_angular_motion": true,
        "requires_physics_owned_object_motion": true
      },
      "promotion": {
        "minimum_success_rate": 0.85,
        "held_out_seed_passes": 3
      }
    },
    {
      "stage": 4,
      "name": "contact_qualified_needle_lift",
      "task": "DrAnmar-Lift-Needle-PSM-IK-Rel-v0",
      "qualification_contract": {
        "control_hz": 50,
        "initial_object_height_m": 0.001,
        "initial_object_quaternion_xyzw": [0.0, 0.0, 0.0, 1.0],
        "target_object_height_m": 0.08,
        "minimum_success_height_m": 0.06,
        "sustained_success_steps": 10,
        "requires_orientation_alignment": true,
        "requires_physics_owned_object_motion": true
      },
      "promotion": {
        "minimum_success_rate": 0.8,
        "held_out_seed_passes": 3
      }
    },
    {
      "stage": 5,
      "name": "physical_block_handover",
      "task": "DrAnmar-Handover-Block-Dual-PSM-IK-Rel-v0",
      "promotion": {
        "minimum_success_rate": 0.75,
        "held_out_seed_passes": 3
      }
    },
    {
      "stage": 6,
      "name": "physical_needle_handover",
      "task": "DrAnmar-Handover-Needle-Dual-PSM-IK-Rel-v0",
      "promotion": {
        "minimum_success_rate": 0.7,
        "held_out_seed_passes": 3
      }
    }
  ],
  "evidence_boundary": {
    "requires_native_runtime": true,
    "requires_checkpoint_hash": true,
    "requires_seeded_evaluation": true,
    "requires_failure_distribution": true,
    "clinical_claims": false
  }
}
